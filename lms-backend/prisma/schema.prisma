generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:ncbh1234@localhost:5433/code_devin_solutions?schema=public"
}

model User {
  id             String           @id @default(cuid())
  name           String
  email          String           @unique
  passwordHash   String
  role           Role             @default(student)
  isVerified     Boolean          @default(false)
  hashedRefreshToken String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  certificates   Certificate[]
  coursesCreated Course[]         @relation("CourseAuthor")
  enrollments    Enrollment[]
  progress       LessonProgress[]
  notifications  Notification[]
  payments       Payment[]
  quizAttempts   QuizAttempt[]
}

model Course {
  id               String        @id @default(cuid())
  title            String
  description      String?
  price            Int           @default(0)
  isFree           Boolean       @default(true)
  thumbnailUrl     String?
  status           CourseStatus  @default(draft)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  createdBy        String
  category         String?
  level            String?
  duration         String?
  learningOutcomes String[]
  certificates     Certificate[]
  author           User          @relation("CourseAuthor", fields: [createdBy], references: [id])
  enrollments      Enrollment[]
  liveClasses      LiveClass[]
  modules          Module[]
  payments         Payment[]
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?
  orderIndex  Int      @default(0)
  lessons     Lesson[]
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Lesson {
  id              String          @id @default(cuid())
  moduleId        String
  title           String
  description     String?
  type            LessonType      @default(video)
  // Media abstraction fields — never store raw storage paths in controllers
  provider        LessonProvider  @default(local)
  providerFileId  String?         // local filename OR cloudflare stream UID OR R2 key
  status          ContentStatus   @default(ready)
  // Legacy & metadata
  videoId         String?
  videoUrl        String?
  resourceUrl     String?
  thumbnail       String?         // optional thumbnail (providerFileId for R2 key or local path)
  learningOutcome String?         // PDF learning outcome text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  durationSeconds Int?
  orderIndex      Int             @default(0)
  module          Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress        LessonProgress[]
  quiz            Quiz?
}

model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  courseId   String
  enrolledAt DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    User     @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId])
}

model Payment {
  id              String   @id @default(cuid())
  studentId       String
  courseId        String
  razorpayOrderId String?
  transactionId   String?
  amount          Int
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student         User     @relation(fields: [studentId], references: [id])
}

model LessonProgress {
  id          String    @id @default(cuid())
  studentId   String
  lessonId    String
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  isCompleted Boolean   @default(false)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student     User      @relation(fields: [studentId], references: [id])

  @@unique([studentId, lessonId])
}

model Quiz {
  id           String         @id @default(cuid())
  lessonId     String         @unique
  title        String
  passingScore Int            @default(80)
  lesson       Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts     QuizAttempt[]
  questions    QuizQuestion[]
}

model QuizQuestion {
  id           String       @id @default(cuid())
  quizId       String
  orderIndex   Int          @default(0)
  questionText String
  questionType String       @default("mcq")
  options      QuizOption[]
  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizOption {
  id         String       @id @default(cuid())
  questionId String
  isCorrect  Boolean      @default(false)
  optionText String
  orderIndex Int          @default(0)
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String   @id @default(cuid())
  studentId   String
  quizId      String
  score       Int      @default(0)
  attemptedAt DateTime @default(now())
  isPassed    Boolean  @default(false)
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     User     @relation(fields: [studentId], references: [id])
}

model Certificate {
  id              String   @id @default(cuid())
  studentId       String
  courseId        String
  certificateCode String   @unique
  pdfUrl          String?
  pdfData         Bytes?
  issuedAt        DateTime @default(now())
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student         User     @relation(fields: [studentId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model LiveClass {
  id              String   @id @default(cuid())
  courseId        String
  title           String
  scheduledAt     DateTime
  zoomMeetingId   String?
  zoomJoinUrl     String?
  createdAt       DateTime @default(now())
  durationMinutes Int      @default(60)
  recordingUrl    String?
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

enum Role {
  student
  admin
  author
}

enum LessonType {
  video
  pdf
}

enum LessonProvider {
  local
  cloudflare_stream
  r2
}

enum ContentStatus {
  uploading
  processing
  ready
  failed
}

enum CourseStatus {
  draft
  published
  archived
}
